<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Servirea API — fundação Spring Boot (Fase 2 do plano mestre, seção 102/125).

        Versão do Spring Boot: 4.1.1. O plano mestre (seção 119) originalmente
        documentava "Spring Boot 3.x", mas em 21/09/2026, ao iniciar esta fase,
        confirmei que a linha 3.5 chegou ao fim do suporte open-source em
        30/06/2026 — hoje a linha suportada é a 4.1.x. Perguntei ao usuário e
        ele confirmou usar Spring Boot 4.1.x já nesta fundação (ver seção 125-A
        do plano mestre). Isso implica Jakarta EE 11 e Spring Framework 7 (o
        código já usa jakarta.* desde o Boot 3, então o impacto prático é baixo
        para este projeto ainda sem módulos de negócio).
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>br.com.servire</groupId>
    <artifactId>servire-api</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>servire-api</name>
    <description>Servirea — API multi-tenant de gestão paroquial (fundação Spring Boot, Fase 2)</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <!-- F08: leitura XLSX por eventos, após limites de ZIP/XML da aplicação. -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.5.1</version>
        </dependency>
        <!-- Web (Spring MVC, síncrono + Virtual Threads — seção 15/68 do plano mestre) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Persistência: Spring Data JPA + Hibernate (seção 15/18) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Driver PostgreSQL (Supabase Postgres via JDBC — seção 1.3) -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway (seção 9/72) — aponta para src/main/resources/db/migration,
             que contém as migrations V001-V015 do baseline da Fase 0/1.

             No Spring Boot 4, a auto-configuration do Flyway foi extraída do
             "spring-boot-autoconfigure" monolítico para um módulo próprio
             ("spring-boot-flyway"), só ativado pelo starter abaixo. Ter
             apenas "flyway-core" no classpath (jeito do Boot 3) compila
             normalmente, mas o Flyway nunca roda — sem log, sem erro,
             silenciosamente (confirmado no guia oficial de migração do
             Spring Boot 4.0: "you now need to replace that with
             spring-boot-starter-flyway"). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Validação de request bodies (usada já nesta fase pelo exception handler
             genérico, mesmo sem endpoints de negócio ainda) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Autenticação própria (Fase 5, seção 32/105). O starter traz o
             Spring Security na versão que o BOM do Spring Boot 4.1.1
             gerencia (linha 7.x, par da Spring Framework 7) — não fixamos
             versão própria aqui, mesma prática já usada para os demais
             starters do projeto. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- JWT (seção 33). O Spring Boot não gerencia versão para o JJWT
             (não é um projeto Spring) — versão 0.13.0 pesquisada e
             confirmada como a mais recente disponível em 21/09/2026.
             jjwt-impl e jjwt-jackson só são necessários em runtime (a API
             pública de assinatura/parsing usada no código-fonte vem só de
             jjwt-api). -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.13.0</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.13.0</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.13.0</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Jackson databind — Jackson 2 (com.fasterxml.*), seção 105, Fase 5.

             IMPORTANTE (corrigido em 21/09/2026 após o Bug real #5, ver
             README.md): esta dependência NÃO é usada pelo código da
             aplicação. A partir do Spring Boot 4, o Jackson padrão da
             aplicação (usado por spring-boot-starter-web para
             serializar/desserializar JSON dos endpoints, e injetado nos
             próprios beans via `tools.jackson.databind.json.JsonMapper`)
             é o Jackson 3 (grupo Maven "tools.jackson.*", pacote Java
             "tools.jackson.*") — um jar completamente separado do Jackson
             2. `jackson-databind` (Jackson 2) só está aqui porque
             jjwt-jackson 0.13.0 (biblioteca de JWT, seção 33) depende
             transitivamente dela como seu motor interno de
             serialização/desserialização de claims — o jjwt-jackson ainda
             não tem suporte ao Jackson 3 (ver
             https://github.com/jwtk/jjwt/issues/1029, consultado em
             21/09/2026). Nenhuma classe do projeto importa
             com.fasterxml.jackson.*.

             Bug real #4 (21/09/2026): ao adicionar spring-security-test
             (escopo test) nesta mesma fase, o Maven passou a resolver
             jackson-databind pelo caminho mais RASO da árvore (via
             spring-security-test), que tem escopo test — a regra de
             mediação "nearest definition" do Maven despreza o caminho mais
             profundo com escopo compile (via jjwt-jackson) em favor do
             mais raso com escopo test, escondendo a classe do classpath de
             compilação principal (`mvn clean verify` falhou com "package
             ... does not exist" em RestAuthenticationEntryPoint/
             RestAccessDeniedHandler, que na época ainda injetavam o
             ObjectMapper do Jackson 2 por engano — ver Bug #5). Declarar a
             dependência aqui, direta e sem escopo (= compile), garante que
             ela vença qualquer mediação por profundidade, independente de
             quais outras dependências a trazem transitivamente. Sem
             versão própria: gerenciada pelo BOM do Spring Boot 4.1.1,
             igual às demais dependências deste arquivo sem <version>. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Actuator: /actuator/health (seção 66) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Logs estruturados em JSON (seção 65) -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>9.0</version>
        </dependency>

        <!-- Testes -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Bug real #12 (22/09/2026, ver README.md): a partir do Spring Boot 4,
             a autoconfiguration de teste também foi modularizada por tecnologia
             web, igual ao que já aconteceu com o próprio starter principal
             (spring-boot-starter-web agora depende de spring-boot-webmvc, não
             mais embutindo tudo num único jar monolítico). `AutoConfigureMockMvc`
             (pacote NOVO: org.springframework.boot.webmvc.test.autoconfigure,
             antes org.springframework.boot.test.autoconfigure.web.servlet) saiu
             de `spring-boot-test-autoconfigure` para este módulo dedicado —
             `spring-boot-starter-test` sozinho não traz mais MockMvc para
             aplicações web. Sem versão própria: gerenciada pelo BOM do Spring
             Boot 4.1.1, igual às demais dependências deste arquivo sem
             <version>. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers 2.x renomeou os artefatos com prefixo "testcontainers-"
             (ex.: "postgresql" -> "testcontainers-postgresql"). O BOM que o
             Spring Boot 4.1.x importa só gerencia versão para os nomes NOVOS;
             usar os nomes antigos ("junit-jupiter"/"postgresql" sem prefixo)
             falha o build com "version ... is missing", pois o Maven não acha
             gerenciamento de versão para eles. Pacotes Java (import) não
             mudaram — continuam em org.testcontainers.containers.* e
             org.testcontainers.junit.jupiter.*. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>

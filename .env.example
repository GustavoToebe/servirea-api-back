# Copie para .env (NUNCA commitar o .env de verdade — seção 90 do plano
# mestre) ou exporte estas variáveis no ambiente/VPS/secret manager.

# Profile ativo: dev (Postgres local) ou prod (Supabase). Não existe um
# profile apontando para produção "por padrão" de propósito.
SPRING_PROFILES_ACTIVE=dev

# Produção (profile prod) — Postgres do Supabase via JDBC (seção 1.3 do
# plano mestre). A conexão direta (db.<ref>.supabase.co) só responde por
# IPv6; se o servidor não tiver IPv6, use o Session pooler (Supabase >
# Connect > Session pooler, porta 5432) — aí o usuário vira
# postgres.<ref>. Acrescente ?sslmode=require se não vier incluído.
DB_URL=jdbc:postgresql://db.qcybebkhwhrudbwoweip.supabase.co:5432/postgres?sslmode=require
DB_USER=postgres
# NUNCA preencher aqui: este arquivo vai para o git. A senha real mora só
# na variável de ambiente do servidor.
DB_PASSWORD=

# Segredo de assinatura dos JWT (profile prod, obrigatório, sem padrão).
JWT_SECRET=

# Origens do front liberadas no CORS (profile prod, obrigatório).
CORS_ALLOWED_ORIGINS=https://app.servirea.com.br

# Domínio pai comum ao front e à API, sem ponto na frente nem https://.
# Sem ele o front não lê o cookie XSRF-TOKEN e /auth/refresh e
# /auth/logout dão 403 (README, seção de CSRF). Vazio = cookie só do
# host da API (serve para dev).
CSRF_COOKIE_DOMAIN=servirea.com.br

# URL do front usada nos links dos e-mails (profile prod, obrigatório).
FRONTEND_BASE_URL=https://app.servirea.com.br

# Supabase Storage (fotos) e Turnstile (profile prod, obrigatórios).
SUPABASE_URL=https://qcybebkhwhrudbwoweip.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
TURNSTILE_SECRET_KEY=

# E-mail: provider resend (padrão em prod) ou log. RESEND_API_KEY é
# obrigatório com resend; RESEND_FROM tem padrão contato@servirea.com.br.
EMAIL_PROVIDER=resend
RESEND_API_KEY=

# Integração com a Central (contrato v1, docs do central-api-back).
# Vazias = /integracao recusa tudo e a sincronização não roda; paróquia
# sem direitos_locais segue no status do tenant. Segredos: 32+ bytes
# aleatórios em Base64, NUNCA aqui.
# Chaves que a Central usa para chamar o Servire: id:segredoBase64[,id:segredoBase64]
SERVIRE_INTEGRACAO_CHAVES_ENTRADA=
# Chave com que o Servire assina a sincronização de 8h.
SERVIRE_INTEGRACAO_CHAVE_SAIDA_ID=
SERVIRE_INTEGRACAO_CHAVE_SAIDA_SEGREDO=
SERVIRE_INTEGRACAO_CENTRAL_URL=
# Horas sem confirmação da Central até bloquear (chave de emergência: aumentar).
SERVIRE_INTEGRACAO_TOLERANCIA_HORAS=72
# Quem recebe o alerta de 24h sem confirmação.
SERVIRE_INTEGRACAO_ALERTA_EMAIL=

# Porta HTTP da aplicação (padrão 8080)
PORT=8080
